{
  "name": "drainage-planner",
  "version": "2.0.0",
  "description": "Expert Yard Drainage Planning System — Construction Manager + Land Surveyor + Landscaping Specialist",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "client:install": "cd client && npm install",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "build": "npm run client:build",
    "dev:full": "concurrently \"npm run dev\" \"npm run client:dev\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "cors": "^2.8.5",
    "xml2js": "^0.4.23"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
